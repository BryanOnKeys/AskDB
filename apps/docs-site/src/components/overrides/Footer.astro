---
/**
 * The page footer: Starlight's edit link and previous/next links, then one quiet row with the
 * machine-readable entry points for coding agents and the author's byline and the
 * copyright year.
 */
import Default from "@astrojs/starlight/components/Footer.astro";
import { withBase } from "../../utils/links";
---

<Default {...Astro.props}>
	<slot />
</Default>
<div class="site-foot">
	<p class="agents">
		<span>Docs for agents</span>
		<a href={withBase("/llms.txt")}>llms.txt</a>
		<a href={withBase("/AGENTS.md")}>AGENTS.md</a>
	</p>
	<p class="by">
		<span>Built by <a href="https://yahyagilany.io">Yahya Gilany</a></span>
		<span>© {new Date().getFullYear()}</span>
	</p>
</div>

<style>
	.site-foot {
		align-items: center;
		color: var(--ask-text-subtle);
		display: flex;
		flex-wrap: wrap;
		font-size: 0.75rem;
		gap: 0.5rem 1.5rem;
		justify-content: space-between;
		line-height: 1.5;
		margin-top: 2rem;
	}

	.site-foot p {
		margin: 0;
	}

	.agents {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.agents a {
		background-color: var(--ask-surface-2);
		border: 1px solid var(--ask-border);
		border-radius: 999px;
		font-family: var(--__sl-font-mono);
		font-size: 0.6875rem;
		padding: 0.0625rem 0.5rem;
	}

	.by {
		align-items: center;
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1rem;
	}

	.site-foot a {
		color: var(--ask-text-muted);
		text-decoration: none;
		transition: color 0.12s ease, border-color 0.12s ease;
	}

	.site-foot a:hover {
		border-color: var(--ask-border-strong);
		color: var(--ask-text);
	}
</style>
