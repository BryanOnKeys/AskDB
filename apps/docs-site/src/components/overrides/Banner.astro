---
/**
 * A site-wide announcement bar above the header, for the 1.0 release-candidate launch. A page
 * that sets its own `banner` in frontmatter keeps Starlight's banner instead. Remove this override
 * (and its line in astro.config.mjs) when the announcement is over.
 */
import Default from "@astrojs/starlight/components/Banner.astro";

const { banner, template } = Astro.locals.starlightRoute.entry.data;
const announcement = "https://yahyagilany.io/articles/askdb-release-candidate";
---

{
	banner ? (
		<Default />
	) : (
		<div class:list={["launch", { sheet: template !== "splash" }]} data-pagefind-ignore>
			<span class="tag">New</span>
			<span>AskDB 1.0 release candidate is out.</span>
			<a href={announcement}>
				Read the announcement <span aria-hidden="true">→</span>
			</a>
		</div>
	)
}

<style>
	.launch {
		align-items: center;
		background-color: var(--ask-accent-soft);
		border-bottom: 1px solid var(--ask-border);
		color: var(--ask-text-body);
		display: flex;
		flex-wrap: wrap;
		font-size: 0.875rem;
		gap: 0.375rem 0.75rem;
		justify-content: center;
		line-height: 1.4;
		margin-bottom: 1rem;
		padding: 0.5rem var(--sl-nav-pad-x);
		text-align: center;
	}

	/* On a docs page the bar sits at the top of the rounded content sheet. */
	.sheet {
		border-radius: var(--ask-radius-lg) var(--ask-radius-lg) 0 0;
	}

	.tag {
		background-color: var(--ask-accent);
		border-radius: 999px;
		color: var(--ask-accent-contrast);
		font-size: 0.6875rem;
		font-weight: 700;
		letter-spacing: 0.06em;
		padding: 0.0625rem 0.5rem;
		text-transform: uppercase;
	}

	.launch a {
		color: var(--ask-accent);
		font-weight: 600;
		text-decoration: none;
	}

	.launch a:hover {
		color: var(--ask-accent-hover);
		text-decoration: underline;
	}
</style>
