{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": ["tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build", "^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.config.ts",
        "$TURBO_ROOT$/askdb.config.ts",
        "$TURBO_ROOT$/scripts/test-utils/**",
        "$TURBO_ROOT$/fixtures/**",
        "!$TURBO_ROOT$/fixtures/**/.data",
        "!$TURBO_ROOT$/fixtures/**/.turbo",
        "!$TURBO_ROOT$/fixtures/**/.vitest"
      ],
      "env": [
        "ASKDB_REQUIRE_INTEGRATION",
        "DATABASE_URL",
        "ASKDB_FIXTURE_HOST",
        "MSSQL_DATABASE_URL",
        "ASKDB_PGVECTOR_URL",
        "PGVECTOR_URL",
        "UPDATE_RAG_GOLDEN"
      ],
      "passThroughEnv": ["ASKDB_TEST_SUMMARY_DIR"],
      "outputs": [".vitest/test-summary.json"]
    },
    "e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": ["ASKDB_VERIFY_ROOT", "CI"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["^build", "^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/test-utils/**"],
      "outputs": []
    }
  }
}
